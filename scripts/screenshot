#!/usr/bin/env bash
set -euo pipefail

mode=${1:-region}
output_dir="$HOME/Pictures/Screenshots"
mkdir -p "$output_dir"
output="$output_dir/$(date +%Y-%m-%d_%H-%M-%S).png"

case "$mode" in
    full)
        grim "$output"
        wl-copy < "$output"
        ;;
    region)
        geometry=$(slurp) || exit 0
        grim -g "$geometry" "$output"
        wl-copy < "$output"
        ;;
    annotate)
        geometry=$(slurp) || exit 0
        grim -g "$geometry" - | satty -f -
        exit 0
        ;;
    *)
        printf 'Usage: %s {full|region|annotate}\n' "$0" >&2
        exit 2
        ;;
esac

notify-send 'Screenshot saved' "$output"

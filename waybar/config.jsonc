{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 4,
  "margin-top": 5,
  "margin-left": 8,
  "margin-right": 8,
  "reload_style_on_change": true,

  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "mpris",
    "privacy",
    "idle_inhibitor",
    "tray",
    "custom/notifications",
    "bluetooth",
    "network",
    "pulseaudio",
    "backlight",
    "battery",
    "custom/power"
  ],

  "custom/launcher": {
    "format": "󰣇",
    "tooltip-format": "Applications\nRight-click: quick settings",
    "on-click": "rofi -show drun",
    "on-click-right": "$HOME/.config/hypr/scripts/system-menu"
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "sort-by-number": true,
    "active-only": false,
    "all-outputs": false,
    "on-scroll-up": "hyprctl dispatch workspace m-1",
    "on-scroll-down": "hyprctl dispatch workspace m+1"
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%a %d %b}",
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "on-scroll": 1
    },
    "on-click-right": "$HOME/.config/hypr/scripts/system-menu"
  },

  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} {dynamic}",
    "dynamic-order": ["title", "artist"],
    "dynamic-len": 24,
    "player-icons": { "default": "󰎈" },
    "status-icons": { "paused": "󰏤" },
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next"
  },

  "privacy": {
    "icon-spacing": 5,
    "icon-size": 13,
    "transition-duration": 250
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰾪"
    },
    "tooltip-format-activated": "Idle lock paused",
    "tooltip-format-deactivated": "Idle lock active\nClick for caffeine mode"
  },

  "tray": {
    "icon-size": 15,
    "spacing": 7,
    "show-passive-items": true
  },

  "custom/notifications": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂚",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰂛",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec-if": "command -v swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "{controller_alias}\n{status}",
    "tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "blueman-manager",
    "on-click-right": "$HOME/.config/hypr/scripts/bluetooth-menu"
  },

  "network": {
    "format-wifi": "󰤨 {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-linked": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid}\n{ipaddr}/{cidr}\n{bandwidthDownBytes} ↓  {bandwidthUpBytes} ↑",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
    "on-click": "nm-connection-editor",
    "on-click-right": "$HOME/.config/hypr/scripts/network-menu"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "󰂰 {volume}%",
    "format-muted": "󰖁",
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋎",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 5,
    "max-volume": 100,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-middle": "pavucontrol",
    "on-click-right": "$HOME/.config/hypr/scripts/audio-menu"
  },

  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-scroll-up": "brightnessctl -e4 -n2 set 5%+",
    "on-scroll-down": "brightnessctl -e4 -n2 set 5%-"
  },

  "battery": {
    "states": {
      "warning": 25,
      "critical": 12
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo}\n{power:.1f} W",
    "on-click": "$HOME/.config/hypr/scripts/power-profile-menu",
    "on-click-right": "$HOME/.config/hypr/scripts/session-menu"
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "Session menu\nRight-click: lock now",
    "on-click": "$HOME/.config/hypr/scripts/session-menu",
    "on-click-right": "loginctl lock-session"
  }
}
